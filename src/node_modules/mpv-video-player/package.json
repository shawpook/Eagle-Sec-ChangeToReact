{
  "name": "@eagle-app/mpv-video-player",
  "version": "1.0.0",
  "description": "Pre-built distribution of mpv-video-player (win-x64)",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./main": {
      "require": "./dist/main/index.cjs",
      "types": "./dist/types/main/index.d.ts"
    },
    "./setup": {
      "require": "./setup.cjs"
    },
    "./core": {
      "import": "./dist/esm/core/index.js",
      "require": "./dist/cjs/core/index.cjs",
      "types": "./dist/types/core/index.d.ts"
    },
    "./components": {
      "import": "./dist/esm/components/index.js",
      "require": "./dist/cjs/components/index.cjs",
      "types": "./dist/types/components/index.d.ts"
    },
    "./plugins": {
      "import": "./dist/esm/plugins/index.js",
      "require": "./dist/cjs/plugins/index.cjs",
      "types": "./dist/types/plugins/index.d.ts"
    },
    "./plugins/*": {
      "import": "./dist/esm/plugins/*/index.js",
      "require": "./dist/cjs/plugins/*/index.cjs",
      "types": "./dist/types/plugins/*/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "prebuilt": {
    "platform": "win32",
    "arch": "x64",
    "electronVersion": "22.3.7",
    "builtAt": "2026-03-04T14:04:05.221Z",
    "builtOn": "win32-x64",
    "nodeVersion": "v20.19.0"
  },
  "peerDependencies": {
    "electron": ">=22.0.0"
  }
}
