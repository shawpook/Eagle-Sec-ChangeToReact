{
  "manifest_version": 3,
  "name": "Eagle Reverse Collector",
  "version": "1.0.0",
  "description": "Collect page images and URLs into Eagle Reverse.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:41593/*",
    "http://localhost:41595/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Eagle Reverse Collector",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
