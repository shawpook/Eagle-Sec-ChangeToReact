{
  "manifest_version": 2,
  "name": "Eagle Reverse Collector MV2 Fixture",
  "version": "1.0.0",
  "description": "Browser extension fixture for capture integration tests.",
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "http://localhost:41593/*",
    "http://localhost:41595/*"
  ]
}
